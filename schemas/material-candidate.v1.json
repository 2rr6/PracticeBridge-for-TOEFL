{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","candidateId","materialId","sourceRevision","sourceTaskId","originalOrdinalInTask","sourceQuestionNumber","taskKind","answerType","fields","fieldStates","fieldEvidence","dependencyRefs","mappings","issues","revision","readiness","adaptationKind","parentCandidateId"],
  "properties":{
    "schemaVersion":{"const":1},"candidateId":{"type":"string","pattern":"^candidate-[a-f0-9-]{36}$"},"materialId":{"type":"string","pattern":"^[a-f0-9-]{36}$"},"sourceRevision":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sourceQuestionId":{"type":["string","null"],"maxLength":128},"sourceTaskId":{"type":"string","minLength":1,"maxLength":300},"originalOrdinalInTask":{"type":["integer","null"],"minimum":1,"maximum":1000},"sourceQuestionNumber":{"type":["integer","string","null"],"maxLength":100},
    "taskKind":{"type":"string","maxLength":100},"answerType":{"type":"string","maxLength":100},"revision":{"type":"integer","minimum":1},"adaptationKind":{"type":["string","null"],"maxLength":100},"parentCandidateId":{"type":["string","null"],"maxLength":100},
    "fields":{"type":"object","additionalProperties":false,"properties":{
      "prompt":{"type":["string","null"],"maxLength":100000},"options":{"type":["array","null"],"maxItems":30,"items":{"type":"object","additionalProperties":false,"required":["id","text"],"properties":{"id":{"type":"string","maxLength":128},"text":{"type":"string","maxLength":20000}}}},
      "answer":{"type":["string","array","null"],"maxLength":100000,"maxItems":100,"items":{"type":"string","maxLength":20000}},"explanation":{"type":["string","null"],"maxLength":200000},"audio":{"type":["string","null"],"maxLength":1000},"image":{"type":["string","null"],"maxLength":1000},"source":{"type":["string","null"],"maxLength":20000},"timeLimitSeconds":{"type":["integer","null"],"minimum":0,"maximum":7200},"prepareSeconds":{"type":["integer","null"],"minimum":0,"maximum":7200},"sentenceFrame":{"type":["string","null"],"maxLength":10000},"answerSlots":{"type":["integer","null"],"minimum":1,"maximum":30},"transcript":{"type":["string","null"],"maxLength":200000},"interaction":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string","maxLength":100},"textField":{"const":"passage"},"offsetUnit":{"const":"utf16"},"textHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sentence":{"type":"string","maxLength":10000},"rawArtifactRef":{"type":"string","pattern":"^[a-f0-9]{64}$"},"candidates":{"type":"array","maxItems":30,"items":{"type":"object","additionalProperties":false,"required":["id","start","end"],"properties":{"id":{"type":"string","maxLength":128},"start":{"type":"integer","minimum":0,"maximum":500000},"end":{"type":"integer","minimum":0,"maximum":500000}}}}}}]}}},
    "fieldStates":{"type":"object","propertyNames":{"enum":["prompt","options","answer","explanation","audio","image","source","timeLimitSeconds","prepareSeconds","sentenceFrame","answerSlots","interaction","transcript"]},"additionalProperties":{"enum":["known","missing","ambiguous","unreadable","notApplicable"]}},
    "fieldEvidence":{"type":"array","maxItems":300,"items":{"type":"object","additionalProperties":false,"required":["path","state","method","visibility","sourceReferences"],"properties":{"path":{"type":"string","maxLength":300},"state":{"enum":["known","missing","ambiguous","unreadable","notApplicable","unmapped","referenced","conflict"]},"method":{"type":"string","maxLength":100},"visibility":{"enum":["source","reference"]},"sourceReferences":{"type":"array","maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["blockId","visibility"],"properties":{"blockId":{"type":"string","maxLength":300},"visibility":{"enum":["source","reference"]}}}},"blockIds":{"type":"array","maxItems":500,"items":{"type":"string","maxLength":300}},"valueLocated":{"type":"boolean"},"artifactRef":{"type":"string","maxLength":100}}}},
    "dependencyRefs":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":100}},
    "mappings":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["targetId","assetId","mappingBasis","mappingState","contentCheckState"],"properties":{"targetId":{"type":"string","maxLength":300},"assetId":{"type":["string","null"],"maxLength":100},"mappingBasis":{"enum":["explicitRef","filename","sequence","user","content"]},"mappingState":{"enum":["proposed","applied","ambiguous","rejected"]},"contentCheckState":{"enum":["notChecked","matched","conflict","inconclusive"]},"contentCheckRef":{"type":"string","pattern":"^[a-f0-9]{64}$"},"contentCheckMethod":{"enum":["asr-text-comparison-v1","user-review"]},"candidateRevision":{"type":"integer","minimum":1},"candidates":{"type":"array","maxItems":200,"items":{"type":"string","maxLength":100}}}}},
    "issues":{"type":"array","maxItems":300,"items":{"type":"object","additionalProperties":false,"required":["code","scope","path","reason","state","evidenceRef"],"properties":{"code":{"type":"string","maxLength":100},"scope":{"type":"string","maxLength":100},"path":{"type":"string","maxLength":300},"reason":{"type":"string","maxLength":2000},"state":{"enum":["open","resolved"]},"evidenceRef":{"type":["string","null"],"maxLength":100}}}},
